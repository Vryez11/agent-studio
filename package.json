{
  "name": "agent-studio",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @agent-studio/api db:generate",
    "db:migrate": "pnpm --filter @agent-studio/api db:migrate",
    "db:studio": "pnpm --filter @agent-studio/api db:studio"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9"
  }
}
